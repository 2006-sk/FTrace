# Copy to .env and fill in. .env is gitignored — never commit the real key.

# Hosted XTrace Memory API. Unset = local deterministic memory only; the demo
# still works end to end. Set it and the service additionally recalls directives
# from XTrace and mirrors call transcripts back to it.
XTRACE_API_KEY=
XTRACE_BASE_URL=https://api.production.xtrace.ai
XTRACE_AGENT_ID=surplus-recovery-agent
XTRACE_APP_ID=xtrace-surplus-recovery
XTRACE_TIMEOUT_MS=6000

# This service's own HTTP surface (what Shresth's backend calls).
XTRACE_PORT=7070
XTRACE_SERVICE_TOKEN=dev-token
XTRACE_REQUIRE_AUTH=true
XTRACE_PERSIST=true
